<Window x:Class="RevitScaffoldingTool.Views.ScaffoldingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Scaffolding Tool — ALINCO Standard (WPF / MVVM)"
        Width="960" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="4,0,0,5">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏗️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="ALINCO SCAFFOLDING AUTOMATION" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Revit 2022 Add-in • WPF / MVVM Architecture • Two-Column Workspace" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN 2-COLUMN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT BÊN TRÁI: GIAO DIỆN CẤU HÌNH THÔNG SỐ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <!-- 1. VỊ TRÍ & CAO ĐỘ Z -->
                    <GroupBox Header="1. Vị Trí &amp; Cao Độ Z (mm)">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Cao độ Z (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding ElevationZ, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="🎯 Chọn Face (Pick Face)" 
                                        Command="{Binding PickFaceForZCommand}" Height="30"
                                        Background="#0284C7"/>
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Text="ℹ️ Tọa độ (X, Y) mặc định luôn lấy (0, 0) theo quy chuẩn."
                                       Foreground="#64748B" FontSize="11" FontStyle="Italic"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. CẤU HÌNH CỘT CHỐNG XẾP TẦNG (6 Ô DỌC, 3 & 4 CÙNG HÀNG) -->
                    <GroupBox Header="2. Cấu Hình Cột Chống Xếp Tầng (Dưới lên trên, 0 = Không đặt)">
                        <StackPanel>
                            <!-- Ô 1: Cột chống 1 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1. Cột chống 1 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post1Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 2: Cột chống 2 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2. Cột chống 2 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post2Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 3 & 4: CÙNG HÀNG (Số lượng cột chống 3 & Cột chống 3) -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3. SL cột chống 3:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post3Count, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="4. Cột chống 3:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="3" Text="{Binding Post3Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 5: Cột chống 4 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="5. Cột chống 4 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post4Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 6: Cột chống 5 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="6. Cột chống 5 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post5Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. SỐ TẦNG & GIẰNG ĐỈNH -->
                    <GroupBox Header="3. Cấu Hình Tầng &amp; Giằng Khóa Đỉnh">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Số tầng sàn (đứng):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StoryCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>

                            <CheckBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="{Binding HasTopTransom}"
                                      Content="Lắp Giằng Đỉnh"
                                      ToolTip="Logic lắp đặt giằng đỉnh liên kết đầu cột i hệt giằng chân"
                                      FontWeight="Normal"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- CỘT BÊN PHẢI: TOÀN BỘ CÁC BUTTONS THỰC THI -->
            <GroupBox Grid.Column="2" Header="4. Chức Năng Thi Công Lắp Dựng">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,0,0">

                        <!-- NÚT MASTER NỔI BẬT LỚN NHẤT -->
                        <Button Content="★ MASTER — FULL 6 TRƯỜNG HỢP LIÊN TỤC ★" 
                                Command="{Binding BuildMasterCommand}"
                                Height="48" FontSize="13" FontWeight="Bold"
                                Background="#059669" Margin="0,0,0,12"/>

                        <!-- NHÓM CÁC TRƯỜNG HỢP GÓC RẼ RIÊNG BIỆT -->
                        <TextBlock Text="Các trường hợp kiểm thử độc lập (Mỗi hệ 2 nhịp):" 
                                   Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <Button Content="TH 1.1: Khớp góc +Y (Mép ngoài phẳng)" 
                                Command="{Binding BuildCase11Command}" 
                                Height="38" Margin="0,0,0,8" Background="#334155"/>

                        <Button Content="TH 1.2: Khớp góc +X (Thu ô vuông 1200x1200)" 
                                Command="{Binding BuildCase12Command}" 
                                Height="38" Margin="0,0,0,8" Background="#334155"/>

                        <Button Content="TH 1.3: Khớp góc -Y (Giằng chéo thu ngắn 600)" 
                                Command="{Binding BuildCase13Command}" 
                                Height="38" Margin="0,0,0,8" Background="#334155"/>

                        <Button Content="TH 1.4: Khớp góc +X (Thu ô vuông 1200x1200)" 
                                Command="{Binding BuildCase14Command}" 
                                Height="38" Margin="0,0,0,8" Background="#334155"/>

                        <Button Content="TH 2.1: Góc rẽ +Y (Nhánh rẽ vươn ngoài đầu hồi)" 
                                Command="{Binding BuildCase21Command}" 
                                Height="38" Margin="0,0,0,8" Background="#475569"/>

                        <Button Content="TH 2.2: Góc rẽ +X (Nhánh rẽ vươn ngoài -Y)" 
                                Command="{Binding BuildCase22Command}" 
                                Height="38" Margin="0,0,0,4" Background="#475569"/>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- STATUS BAR PHÍA DƯỚI CÙNG -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="4" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#0F172A" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
