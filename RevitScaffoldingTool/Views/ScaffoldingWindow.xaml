<Window x:Class="RevitScaffoldingTool.Views.ScaffoldingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Scaffolding Tool — ALINCO Standard (Dark Theme • WPF / MVVM)"
        Width="1320" Height="780"
        MinWidth="1120" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Dark GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="4,0,0,5">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter TextElement.Foreground="#E2E8F0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="SelectionBrush" Value="#0284C7"/>
        </Style>

        <!-- Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Dark Button Style -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="#475569" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#075985"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid ColumnHeader Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Dark DataGrid Row & Cell Styles -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26354D"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER (DARK THEME) -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏗️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="ALINCO SCAFFOLDING AUTOMATION — DARK EDITION" Foreground="#38BDF8" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Revit 2022 Add-in • Chuỗi Nhịp Động L0 → L6 • Chế Độ Continue Tuần Tự 6 Trường Hợp (TH 1.1 → TH 2.2)" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN 3-COLUMN WORKSPACE: TABLE (TRÁI) - DATA (GIỮA) - BUTTONS (PHẢI) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT BÊN TRÁI: TABLE NHỊP GIÀN + NÚT QUÉT SELECT -->
            <GroupBox Grid.Column="0" Header="1. Bảng Tuyến Hệ Giàn (Detail Line)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 2 NÚT ĐẦU CỘT TRÁI: QUÉT (SELECT) & CHẠY (RUN THEO TABLE) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🎯 Quét (Select)"
                                Command="{Binding SelectInstancesCommand}"
                                Height="34" Background="#0284C7"
                                ToolTip="Quét các instance Review_DetailLine trong View đưa vào Table và đồng bộ sang L0..L6"/>
                        <Button Grid.Column="2" Content="▶ Chạy (Run)"
                                Command="{Binding RunBaysCommand}"
                                Height="34" Background="#059669"
                                ToolTip="Chạy theo Table: Row 1 như L0, Row 2 như L1,... Cột Connect chọn hàm TH để chạy nối tiếp; Row cuối nếu không nối về Row 1 thì Connect = TH 0"/>
                    </Grid>

                    <!-- DATAGRID: DANH SÁCH HỆ GIÀN (DARK THEME) -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding BayRows}"
                              SelectedItem="{Binding SelectedBayRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#334155"
                              VerticalGridLinesBrush="#334155"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="#0F172A"
                              AlternatingRowBackground="#162032"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <!-- Cột STT -->
                            <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="35" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột ID -->
                            <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="65" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột List Nhịp: 1800,2x1200,1800,3x1200,... -->
                            <DataGridTextColumn Header="List nhịp" Binding="{Binding BayList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Connect: ComboBox 6 TH -->
                            <DataGridTemplateColumn Header="Connect" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ConnectCases, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding ConnectCase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Background="#0F172A" Foreground="#0F172A"
                                                  Height="26" VerticalContentAlignment="Center" Margin="2,1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- CỘT Ở GIỮA: VÙNG DATA CẤU HÌNH THÔNG SỐ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">

                    <!-- 1. VỊ TRÍ, CHÂN CHỐNG & CAO ĐỘ Z -->
                    <GroupBox Header="2. Vị Trí &amp; Cao Độ Z (Data mm)">
                        <StackPanel>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Cao độ Z (mm):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding ElevationZ, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="🎯 Pick Face" 
                                        Command="{Binding PickFaceForZCommand}" Height="26"
                                        Background="#0284C7"/>
                            </Grid>

                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Kích chân (mm):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding JackHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="(Chuẩn 250 mm)" VerticalAlignment="Center"
                                           Foreground="#94A3B8" FontSize="11" FontStyle="Italic"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. CẤU HÌNH CỘT CHỐNG XẾP TẦNG -->
                    <GroupBox Header="3. Cột Chống Xếp Tầng (Data mm)">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1. Cột chống 1 (mm):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding Post1Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2. Cột chống 2 (mm):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding Post2Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3. SL cột chống 3:" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding Post3Count, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="4. Cột 3:" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="3" Text="{Binding Post3Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="5. Cột chống 4 (mm):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding Post4Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="6. Cột chống 5 (mm):" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                                <TextBox Grid.Column="1" Text="{Binding Post5Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. SỐ TẦNG & GIẰNG ĐỈNH -->
                    <GroupBox Header="4. Số Tầng &amp; Giằng Đỉnh (Data)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Số tầng sàn:" VerticalAlignment="Center" FontWeight="Normal" Foreground="#E2E8F0"/>
                            <TextBox Grid.Column="1" Text="{Binding StoryCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>

                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="{Binding HasTopTransom}"
                                      Content="Lắp Giằng Đỉnh"
                                      FontWeight="Normal"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- CỘT BÊN PHẢI: L0..L6, W, CHECKBOXES 6 TH & CÁC BUTTONS THI CÔNG -->
            <GroupBox Grid.Column="4" Header="5. Cấu Hình Nhịp L0 → L6 &amp; Thi Công Theo Trường Hợp">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,0">

                        <!-- CHECKBOX FROM DATA -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsFromData, Mode=TwoWay}" FontWeight="Bold" Foreground="#38BDF8"
                                          Content="From data (Áp dụng Cao độ Z, Cột chống, Số tầng ở Cột giữa)"/>
                            </StackPanel>
                        </Border>

                        <!-- CẤU HÌNH CHUỖI NHỊP L0 -> L6 VÀ W -->
                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Chuỗi nhịp hệ giàn L0 → L6 &amp; Bề rộng W (mm):" FontWeight="Bold" Foreground="#38BDF8" FontSize="11.5" Margin="0,0,0,6"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="L0 (Giàn 0):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ButtonL0, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn đầu của TH 1.1 (L0 => L1). Hỗ trợ dạng: 1800,2x1200,1800,..."/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="L1 (Giàn 1):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ButtonL1, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn sau của TH 1.1 &amp; Giàn đầu của TH 1.2 (L1 => L2)"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="L2 (Giàn 2):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ButtonL2, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn sau của TH 1.2 &amp; Giàn đầu của TH 1.3 (L2 => L3)"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="L3 (Giàn 3):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ButtonL3, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn sau của TH 1.3 &amp; Giàn đầu của TH 1.4 (L3 => L4)"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="L4 (Giàn 4):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ButtonL4, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn sau của TH 1.4 &amp; Giàn đầu của TH 2.1 (L4 => L5)"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="L5 (Giàn 5):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ButtonL5, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn sau của TH 2.1 &amp; Giàn đầu của TH 2.2 (L5 => L6)"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="L6 (Giàn 6):" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ButtonL6, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"
                                             ToolTip="Giàn sau kết thúc của TH 2.2 (L5 => L6)"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="W (Rộng mm):" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding ButtonW, UpdateSourceTrigger=PropertyChanged}" Height="22" FontSize="11"/>
                                </Grid>

                                <TextBlock Text="• Cú pháp: 1800,2x1200,1800,3x1200,... • Tích CheckBox bên dưới để chạy nối tiếp trong MASTER."
                                           Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- NÚT MASTER CONTINUE NỔI BẬT -->
                        <Button Content="★ MASTER — CHẠY CONTINUE CÁC TH ĐÃ TÍCH CHỌN ★" 
                                Command="{Binding BuildMasterCommand}"
                                Height="42" FontSize="12" FontWeight="Bold"
                                Background="#059669" Margin="0,0,0,8"
                                ToolTip="Chạy nối tiếp (Continue) các TH có CheckBox = True: TH 1.1 (L0⇒L1) → TH 1.2 (L1⇒L2) → TH 1.3 (L2⇒L3) → TH 1.4 (L3⇒L4) → TH 2.1 (L4⇒L5) → TH 2.2 (L5⇒L6)"/>

                        <TextBlock Text="Tích CheckBox để nối tiếp trong Master • Bấm nút để chạy lẻ từng TH:" 
                                   Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>

                        <!-- TH 1.1: CheckBox 1 + Button -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase11, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 1.1 (L0 => L1) khi chạy Master"/>
                            <Button Grid.Column="1" Content="TH 1.1 (L0 ⇒ L1): Khớp góc +Y (Mép phẳng)" 
                                    Command="{Binding BuildCase11Command}" 
                                    Height="32" Background="#1E3A8A"/>
                        </Grid>

                        <!-- TH 1.2: CheckBox 2 + Button -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase12, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 1.2 Continue (L1 => L2) khi chạy Master"/>
                            <Button Grid.Column="1" Content="TH 1.2 (L1 ⇒ L2): Khớp góc +X (Thu góc)" 
                                    Command="{Binding BuildCase12Command}" 
                                    Height="32" Background="#1E3A8A"/>
                        </Grid>

                        <!-- TH 1.3: CheckBox 3 + Button -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase13, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 1.3 Continue (L2 => L3) khi chạy Master"/>
                            <Button Grid.Column="1" Content="TH 1.3 (L2 ⇒ L3): Khớp góc -Y (Giằng thu)" 
                                    Command="{Binding BuildCase13Command}" 
                                    Height="32" Background="#1E3A8A"/>
                        </Grid>

                        <!-- TH 1.4: CheckBox 4 + Button -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase14, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 1.4 Continue (L3 => L4) khi chạy Master"/>
                            <Button Grid.Column="1" Content="TH 1.4 (L3 ⇒ L4): Khớp góc +X (Thu góc)" 
                                    Command="{Binding BuildCase14Command}" 
                                    Height="32" Background="#1E3A8A"/>
                        </Grid>

                        <!-- TH 2.1: CheckBox 5 + Button -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase21, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 2.1 Continue (L4 => L5) khi chạy Master"/>
                            <Button Grid.Column="1" Content="TH 2.1 (L4 ⇒ L5): Góc rẽ +Y (Vươn ngoài)" 
                                    Command="{Binding BuildCase21Command}" 
                                    Height="32" Background="#3B0764"/>
                        </Grid>

                        <!-- TH 2.2: CheckBox 6 + Button -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase22, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 2.2 Continue (L5 => L6) khi chạy Master"/>
                            <Button Grid.Column="1" Content="TH 2.2 (L5 ⇒ L6): Góc rẽ +X (Vươn ngoài)" 
                                    Command="{Binding BuildCase22Command}" 
                                    Height="32" Background="#3B0764"/>
                        </Grid>

                        <!-- TH 3.1: CheckBox 7 + Button -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding CheckCase31, Mode=TwoWay}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      ToolTip="Bật/Tắt TH 3.1 (dự phòng)"/>
                            <Button Grid.Column="1" Content="TH 3.1 (L0 ⇒ L1): Khớp Ngã Ba Chữ T (T-Junction)" 
                                    Command="{Binding BuildCase31Command}" 
                                    Height="32" Background="#0D9488"
                                    ToolTip="TH 3.1: Dãy chính chạy thẳng liên tục qua ngã ba; Nhánh rẽ đâm vuông góc +Y về bên phải đường tim (W = 1200 mm)."/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- STATUS BAR PHÍA DƯỚI CÙNG (DARK THEME) -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#38BDF8" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
