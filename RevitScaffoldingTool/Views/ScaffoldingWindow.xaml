<Window x:Class="RevitScaffoldingTool.Views.ScaffoldingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Scaffolding Tool — ALINCO Standard (WPF / MVVM)"
        Width="1280" Height="720"
        MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="4,0,0,5">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏗️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="ALINCO SCAFFOLDING AUTOMATION" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Revit 2022 Add-in • WPF / MVVM Architecture • Three-Column Workspace (Table - Data - Actions)" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN 3-COLUMN WORKSPACE: TABLE (TRÁI) - DATA (GIỮA) - BUTTONS (PHẢI) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT BÊN TRÁI: TABLE NHỊP GIÀN + 2 NÚT SELECT & RUN -->
            <GroupBox Grid.Column="0" Header="1. Bảng Tuyến Hệ Giàn (Detail Line)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 2 BUTTONS: SELECT (QUÉT) & RUN (CHẠY GIÀN) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="🎯 Quét (Select)"
                                Command="{Binding SelectInstancesCommand}"
                                Height="34" Background="#0284C7"
                                ToolTip="Quét chọn hoặc tự động quét các instance Review_DetailLine trong View"/>

                        <Button Grid.Column="2" Content="▶ Chạy (Run)"
                                Command="{Binding RunBaysCommand}"
                                Height="34" Background="#059669"
                                ToolTip="Lắp dựng giàn giáo cho hệ giàn đang chọn theo Data"/>
                    </Grid>

                    <!-- DATAGRID: DANH SÁCH HỆ GIÀN -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding BayRows}"
                              SelectedItem="{Binding SelectedBayRow, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E2E8F0"
                              VerticalGridLinesBrush="#E2E8F0"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              Background="#FFFFFF"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <!-- Cột STT -->
                            <DataGridTextColumn Header="#" Binding="{Binding Stt}" Width="35" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột ID -->
                            <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="65" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột List Nhịp: NxL,xxxx -->
                            <DataGridTextColumn Header="List nhịp" Binding="{Binding BayList}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="4,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Connect: ComboBox 6 TH -->
                            <DataGridTemplateColumn Header="Connect" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ConnectCases, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding ConnectCase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Height="26" VerticalContentAlignment="Center" Margin="2,1"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- CỘT Ở GIỮA: VÙNG DATA CẤU HÌNH THÔNG SỐ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">

                    <!-- 1. VỊ TRÍ, CHÂN CHỐNG & CAO ĐỘ Z -->
                    <GroupBox Header="2. Vị Trí &amp; Cao Độ Z (Data mm)">
                        <StackPanel>
                            <!-- Cao độ Z & Chọn Face -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Cao độ Z (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding ElevationZ, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="🎯 Pick Face" 
                                        Command="{Binding PickFaceForZCommand}" Height="28"
                                        Background="#0284C7"/>
                            </Grid>

                            <!-- Chân chống (Kích chân) -->
                            <Grid Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Kích chân (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding JackHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="(Chuẩn 250 mm)" VerticalAlignment="Center"
                                           Foreground="#64748B" FontSize="11" FontStyle="Italic"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. CẤU HÌNH CỘT CHỐNG XẾP TẦNG (6 Ô DỌC, 3 & 4 CÙNG HÀNG) -->
                    <GroupBox Header="3. Cột Chống Xếp Tầng (Data mm)">
                        <StackPanel>
                            <!-- Ô 1: Cột chống 1 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1. Cột chống 1 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post1Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 2: Cột chống 2 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2. Cột chống 2 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post2Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 3 & 4: CÙNG HÀNG (Số lượng cột chống 3 & Cột chống 3) -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="3. SL cột chống 3:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post3Count, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="4. Cột 3:" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="3" Text="{Binding Post3Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 5: Cột chống 4 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="5. Cột chống 4 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post4Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Ô 6: Cột chống 5 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="6. Cột chống 5 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                                <TextBox Grid.Column="1" Text="{Binding Post5Height, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. SỐ TẦNG & GIẰNG ĐỈNH -->
                    <GroupBox Header="4. Số Tầng &amp; Giằng Đỉnh (Data)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Số tầng sàn:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" Text="{Binding StoryCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>

                            <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                      IsChecked="{Binding HasTopTransom}"
                                      Content="Lắp Giằng Đỉnh"
                                      FontWeight="Normal"/>
                        </Grid>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- CỘT BÊN PHẢI: TOÀN BỘ CÁC BUTTONS THI CÔNG (LUÔN CHẠY THEO DATA) -->
            <GroupBox Grid.Column="4" Header="5. Thi Công Theo Trường Hợp">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,2,0,0">

                        <!-- THÔNG BÁO QUY CHUẨN RUN THEO DATA -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚡ Chế độ thi công: Luôn theo Data" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Mọi nút bấm đều tự động áp dụng thông số từ Cột Data ở giữa."
                                           Foreground="#475569" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- NÚT MASTER NỔI BẬT LỚN NHẤT -->
                        <Button Content="★ MASTER — FULL 6 TH LIÊN TỤC ★" 
                                Command="{Binding BuildMasterCommand}"
                                Height="46" FontSize="12" FontWeight="Bold"
                                Background="#059669" Margin="0,0,0,10"/>

                        <!-- NHÓM CÁC TRƯỜNG HỢP GÓC RẼ RIÊNG BIỆT -->
                        <TextBlock Text="Chạy đơn lẻ từng trường hợp góc nối:" 
                                   Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <Button Content="TH 1.1: Khớp góc +Y (Mép phẳng)" 
                                Command="{Binding BuildCase11Command}" 
                                Height="34" Margin="0,0,0,6" Background="#334155"/>

                        <Button Content="TH 1.2: Khớp góc +X (Thu 1200x1200)" 
                                Command="{Binding BuildCase12Command}" 
                                Height="34" Margin="0,0,0,6" Background="#334155"/>

                        <Button Content="TH 1.3: Khớp góc -Y (Giằng thu 600)" 
                                Command="{Binding BuildCase13Command}" 
                                Height="34" Margin="0,0,0,6" Background="#334155"/>

                        <Button Content="TH 1.4: Khớp góc +X (Thu 1200x1200)" 
                                Command="{Binding BuildCase14Command}" 
                                Height="34" Margin="0,0,0,6" Background="#334155"/>

                        <Button Content="TH 2.1: Góc rẽ +Y (Vươn ngoài)" 
                                Command="{Binding BuildCase21Command}" 
                                Height="34" Margin="0,0,0,6" Background="#475569"/>

                        <Button Content="TH 2.2: Góc rẽ +X (Vươn ngoài -Y)" 
                                Command="{Binding BuildCase22Command}" 
                                Height="34" Margin="0,0,0,4" Background="#475569"/>

                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- STATUS BAR PHÍA DƯỚI CÙNG -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="4" Padding="12,8" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#0F172A" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
