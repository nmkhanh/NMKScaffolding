<Window x:Class="RevitScaffoldingTool.Views.ScaffoldingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Scaffolding Tool — ALINCO Standard (WPF / MVVM)"
        Width="680" Height="780"
        MinWidth="580" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,8,12,12"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D2939"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Margin="4,0,0,4">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#101828"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#B0BEC5"/>
                                <Setter Property="Foreground" Value="#ECEFF1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏗️" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="ALINCO SCAFFOLDING AUTOMATION" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Revit 2022 Add-in • WPF / MVVM Architecture • Multi-tier Post Engine" Foreground="#94A3B8" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">

                <!-- SECTION 1: CAO ĐỘ Z & ĐIỂM ĐẶT -->
                <GroupBox Header="1. Vị Trí &amp; Cao Độ Z (mm)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cao độ Z (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ElevationZ, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="🎯 Chọn Face (Pick Face Element)" 
                                Command="{Binding PickFaceForZCommand}" HorizontalAlignment="Left" Width="240"
                                Background="#0284C7"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                   Text="ℹ️ Tọa độ (X, Y) mặc định luôn lấy (0, 0) theo quy chuẩn."
                                   Foreground="#64748B" FontSize="11" FontStyle="Italic"/>
                    </Grid>
                </GroupBox>

                <!-- SECTION 2: CẤU HÌNH CỘT CHỐNG XẾP TẦNG (6 Ô) -->
                <GroupBox Header="2. Cấu Hình Cột Chống Xếp Tầng (Chiều cao từ dưới lên trên, 0 = Không đặt)">
                    <StackPanel>
                        <!-- Ô 1: Cột chống 1 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1. Cột chống 1 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" Text="{Binding Post1Height, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Ô 2: Cột chống 2 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2. Cột chống 2 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" Text="{Binding Post2Height, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Ô 3 & 4: CÙNG HÀNG (Số lượng cột chống 3 & Cột chống 3) -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="3. Số lượng cột chống 3:" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" Text="{Binding Post3Count, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="4. Cột chống 3 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="3" Text="{Binding Post3Height, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Ô 5: Cột chống 4 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="5. Cột chống 4 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" Text="{Binding Post4Height, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Ô 6: Cột chống 5 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="6. Cột chống 5 (mm):" VerticalAlignment="Center" FontWeight="Normal"/>
                            <TextBox Grid.Column="1" Text="{Binding Post5Height, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- SECTION 3: SỐ TẦNG & GIẰNG ĐỈNH -->
                <GroupBox Header="3. Cấu Hình Tầng &amp; Giằng Khóa Đỉnh">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Số tầng (sàn thao tác đứng):" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StoryCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>

                        <CheckBox Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                                  IsChecked="{Binding HasTopTransom}"
                                  Content="Lắp đặt Giằng Đỉnh (logic i hệt giằng chân)"
                                  FontWeight="Normal"/>
                    </Grid>
                </GroupBox>

                <!-- SECTION 4: THỰC THI THI CÔNG (BUTTONS) -->
                <GroupBox Header="4. Chức Năng Lắp Dựng Giàn Giáo ALINCO">
                    <StackPanel>
                        <!-- Nút Master lớn nhất -->
                        <Button Content="★ MASTER - DẢI LIÊN TỤC FULL 6 TRƯỜNG HỢP (MỖI HỆ 2 NHỊP) ★" 
                                Command="{Binding BuildMasterCommand}"
                                Height="42" FontSize="13" FontWeight="Bold"
                                Background="#059669" Margin="0,0,0,8"/>

                        <!-- Lưới nút các trường hợp góc rẽ -->
                        <UniformGrid Columns="2" Margin="0,2">
                            <Button Content="TH 1.1: Khớp góc +Y phẳng" Command="{Binding BuildCase11Command}" Margin="0,0,4,6" Background="#334155"/>
                            <Button Content="TH 1.2: Khớp góc +X 1200x1200" Command="{Binding BuildCase12Command}" Margin="4,0,0,6" Background="#334155"/>
                            <Button Content="TH 1.3: Khớp góc -Y giằng thu ngắn" Command="{Binding BuildCase13Command}" Margin="0,0,4,6" Background="#334155"/>
                            <Button Content="TH 1.4: Khớp góc +X 1200x1200" Command="{Binding BuildCase14Command}" Margin="4,0,0,6" Background="#334155"/>
                            <Button Content="TH 2.1: Góc rẽ +Y vươn ngoài" Command="{Binding BuildCase21Command}" Margin="0,0,4,0" Background="#475569"/>
                            <Button Content="TH 2.2: Góc rẽ +X vươn ngoài -Y" Command="{Binding BuildCase22Command}" Margin="4,0,0,0" Background="#475569"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#1E293B" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
